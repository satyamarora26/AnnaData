# ============================================================
# AnnaData Backend - environment configuration
# Copy to .env and fill in. Only GEMINI_API_KEY is required.
# ============================================================

# --- REQUIRED ---
# Google AI Studio -> https://aistudio.google.com/apikey  (free tier available)
GEMINI_API_KEY=

# --- OPTIONAL: each unlocks one feature, absence disables just that feature ---

# Geocoding turns a place name into coordinates, which is what gives SMS access
# to the soil, weather and price tools. It works with NO key: OpenStreetMap's
# Nominatim is the default. Set LOCATION_API_KEY only to switch to Google Maps,
# which handles messy village names better but needs a billing account.
LOCATION_API_KEY=
# Nominatim's policy requires a User-Agent naming the app and a way to reach
# you. Put a real contact address here before running real traffic.
NOMINATIM_USER_AGENT=AnnaData/1.0 (agricultural advisory; +your-contact-here)
GEOCODE_COUNTRY=in

# data.gov.in API key for mandi (market) prices. Free registration.
# https://data.gov.in/user/register  -> profile -> API key
GOV_API_KEY=

# Google Earth Engine service account key, as a single-line JSON string.
# Powers soil texture, pH and organic carbon. Free for non-commercial use.
# Convert the downloaded key file with:
#     python tools/ee_key_to_env.py path/to/key.json
EE_SERVICE_KEY=
# Only needed if the project registered with Earth Engine differs from the one
# named inside the key file.
EE_PROJECT=

# AWS Bedrock knowledge base for government schemes and cold storage.
KNOWLEDGE_BASE_ID=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# --- FARMER PROFILES (optional) ---
# Postgres connection string. Without it the agent is stateless: no memory,
# no personalisation, exactly as before. Neon works well - it scales to zero
# between messages, which suits intermittent SMS traffic.
#   https://neon.tech  ->  create project  ->  copy the connection string
DATABASE_URL=
# Turns of conversation replayed to the model, and how stale they may be.
CONTEXT_MESSAGES=10
CONTEXT_TTL_HOURS=48
# How long before a farmer who ignored the location question is asked again.
LOCATION_ASK_COOLDOWN_HOURS=24

# --- DEPLOYMENT ---
# Public URL of the frontend, added to the CORS allowlist.
FRONTEND_URL=
# Any extra allowed origins, comma-separated.
CORS_ORIGINS=

# --- TUNING (safe defaults) ---
# Comma-separated, fastest first. Tried in order; a quota (429), overload (503)
# or missing-model (404) error fails over to the next. Free-tier quota is per
# model, so the fallbacks also multiply usable daily capacity.
TEXT_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash-lite
MEDIA_MODEL=gemini-3.5-flash-lite
# Retries within one model before failing over. Keep low - the default backoff
# stalls ~60s on a quota error when another model would answer instantly.
LLM_MAX_RETRIES=1
# The last model has nothing behind it, so it retries a little harder.
LLM_LAST_RESORT_RETRIES=3
MANDI_MAX_RECORDS=80
HTTP_TIMEOUT=20
