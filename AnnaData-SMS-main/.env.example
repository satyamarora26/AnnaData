# ============================================================
# AnnaData SMS Bridge - environment configuration
# Copy to .env and fill in.
# ============================================================

# cloud   = api.sms-gate.app  (recommended: no LAN, no ngrok)
# local   = the phone's own server on your LAN (needs DEVICE_IP)
# private = your own self-hosted gateway (needs PRIVATE_BASE_URL)
SMS_MODE=cloud

# --- Gateway credentials ---
# In cloud mode these are shown in the Android app under "Cloud Server".
APP_USERNAME=
PASSWORD=

# --- Cloud mode (default) ---
CLOUD_BASE_URL=https://api.sms-gate.app/3rdparty/v1

# --- Local mode only ---
DEVICE_IP=
DEVICE_PORT=8080

# --- Private mode only ---
PRIVATE_BASE_URL=

# --- Wiring ---
# The backend's /agent endpoint.
AI_ENDPOINT=https://your-backend-url/agent
# The public HTTPS URL where THIS bridge is reachable. Used by webhook.py to
# register the sms:received webhook.
PUBLIC_URL=https://your-sms-bridge-url

# --- Tuning ---
WEBHOOK_PATH=/incoming-sms
# Appended when the backend still does not know where the farmer is. Shares the
# answer's segment budget rather than adding a paid segment of its own.
LOCATION_PROMPT=Reply with your district for advice specific to your area.
# Messages that erase a farmer's stored data, comma separated.
STOP_WORDS=stop,band,band karo,unsubscribe,hatao
STOP_REPLY=Your saved details have been deleted. Message us any time to start again.
DEDUP_TTL=600
# A sleeping free-tier backend can take ~140s to wake.
AI_TIMEOUT=150
# Attempts per incoming SMS. The first can be spent waking the backend.
AI_ATTEMPTS=2
SMS_TIMEOUT=30
# Hard character ceiling.
MAX_SMS_CHARS=480
# Billed SMS segments - the cap that actually controls cost. Latin packs 153
# chars per segment, Devanagari/Gurmukhi only 67, so cap segments not chars.
MAX_SMS_SEGMENTS=4
